{
  "$schema": "vscode://schemas/color-theme",
  "name": "Pop Art - Keith Haring (Electric 80s)",
  "type": "dark",
  "colors": {
    "focusBorder": "#FFB703AA",
    "foreground": "#F8F9FC",
    "widget.shadow": "#00000088",
    "selection.background": "#403554",
    "descriptionForeground": "#8F89A4",
    "errorForeground": "#FF3E8A",

    "editor.background": "#171620",
    "editor.foreground": "#F8F9FC",
    "editorLineNumber.foreground": "#5B5470",
    "editorLineNumber.activeForeground": "#FFB703",
    "editorCursor.foreground": "#FF3E8A",
    "editorCursor.background": "#171620",
    "editor.selectionBackground": "#403554AA",
    "editor.inactiveSelectionBackground": "#2F263E88",
    "editor.selectionHighlightBackground": "#40355455",
    "editor.wordHighlightBackground": "#FFB70322",
    "editor.wordHighlightStrongBackground": "#FFB70333",
    "editor.findMatchBackground": "#FFB70355",
    "editor.findMatchHighlightBackground": "#00F0FF33",
    "editor.findRangeHighlightBackground": "#40355433",
    "editor.hoverHighlightBackground": "#242131",
    "editor.lineHighlightBackground": "#242131",
    "editor.lineHighlightBorder": "#00000000",
    "editorLink.activeForeground": "#00F0FF",
    "editorWhitespace.foreground": "#322C43",
    "editorIndentGuide.background1": "#292437",
    "editorIndentGuide.activeBackground1": "#5E537E",
    "editorRuler.foreground": "#292437",
    "editorBracketMatch.background": "#403554",
    "editorBracketMatch.border": "#00F0FF",
    "editorGutter.background": "#171620",
    "editorGutter.modifiedBackground": "#FFB703",
    "editorGutter.addedBackground": "#70FF00",
    "editorGutter.deletedBackground": "#FF3E8A",

    "activityBar.background": "#0D0C14",
    "activityBar.foreground": "#FFB703",
    "activityBar.inactiveForeground": "#5B5470",
    "activityBar.border": "#2C293D",
    "activityBarBadge.background": "#FF3E8A",
    "activityBarBadge.foreground": "#FFFFFF",

    "sideBar.background": "#111018",
    "sideBar.foreground": "#C4BFD4",
    "sideBar.border": "#2C293D",
    "sideBarTitle.foreground": "#F8F9FC",
    "sideBarSectionHeader.background": "#111018",
    "sideBarSectionHeader.foreground": "#F8F9FC",
    "sideBarSectionHeader.border": "#2C293D",

    "tab.activeBackground": "#171620",
    "tab.activeForeground": "#F8F9FC",
    "tab.activeBorderTop": "#FF3E8A",
    "tab.inactiveBackground": "#111018",
    "tab.inactiveForeground": "#8F89A4",
    "tab.border": "#2C293D",
    "tab.hoverBackground": "#1C1B28",
    "tab.unfocusedActiveBackground": "#171620",
    "tab.unfocusedActiveForeground": "#C4BFD4",
    "tab.unfocusedInactiveForeground": "#655E7A",
    "editorGroupHeader.tabsBackground": "#111018",
    "editorGroupHeader.tabsBorder": "#2C293D",
    "editorGroup.border": "#2C293D",

    "statusBar.background": "#111018",
    "statusBar.foreground": "#C4BFD4",
    "statusBar.border": "#2C293D",
    "statusBar.debuggingBackground": "#FF3E8A",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBar.noFolderBackground": "#111018",
    "statusBarItem.hoverBackground": "#242131",
    "statusBarItem.remoteBackground": "#FFB703",
    "statusBarItem.remoteForeground": "#0D0C14",

    "titleBar.activeBackground": "#111018",
    "titleBar.activeForeground": "#C4BFD4",
    "titleBar.inactiveBackground": "#0D0C14",
    "titleBar.inactiveForeground": "#655E7A",
    "titleBar.border": "#2C293D",

    "menu.background": "#171620",
    "menu.foreground": "#F8F9FC",
    "menu.selectionBackground": "#322944",
    "menu.selectionForeground": "#FFB703",
    "menu.separatorBackground": "#2C293D",
    "menu.border": "#2C293D",

    "quickInput.background": "#171620",
    "quickInput.foreground": "#F8F9FC",
    "pickerGroup.border": "#2C293D",
    "pickerGroup.foreground": "#FFB703",

    "list.activeSelectionBackground": "#322944",
    "list.activeSelectionForeground": "#FFB703",
    "list.inactiveSelectionBackground": "#221E2E",
    "list.inactiveSelectionForeground": "#F8F9FC",
    "list.hoverBackground": "#221E2E",
    "list.focusBackground": "#322944",
    "list.highlightForeground": "#FFB703",

    "input.background": "#111018",
    "input.foreground": "#F8F9FC",
    "input.border": "#3B3651",
    "input.placeholderForeground": "#655E7A",
    "inputOption.activeBorder": "#FFB703",

    "badge.background": "#FFB703",
    "badge.foreground": "#0D0C14",

    "button.background": "#FF3E8A",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#E62B75",
    "button.secondaryBackground": "#322944",
    "button.secondaryForeground": "#F8F9FC",
    "button.secondaryHoverBackground": "#403554",

    "dropdown.background": "#111018",
    "dropdown.foreground": "#F8F9FC",
    "dropdown.border": "#3B3651",

    "terminal.background": "#111018",
    "terminal.foreground": "#F8F9FC",
    "terminal.ansiBlack": "#171620",
    "terminal.ansiRed": "#FF3E8A",
    "terminal.ansiGreen": "#70FF00",
    "terminal.ansiYellow": "#FFB703",
    "terminal.ansiBlue": "#00F0FF",
    "terminal.ansiMagenta": "#B5179E",
    "terminal.ansiCyan": "#38BDF8",
    "terminal.ansiWhite": "#F8F9FC",
    "terminal.ansiBrightBlack": "#5B5470",
    "terminal.ansiBrightRed": "#FF61A1",
    "terminal.ansiBrightGreen": "#8CFF33",
    "terminal.ansiBrightYellow": "#FFCA40",
    "terminal.ansiBrightBlue": "#4DF4FF",
    "terminal.ansiBrightMagenta": "#D634BE",
    "terminal.ansiBrightCyan": "#6ADBFF",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "gitDecoration.modifiedResourceForeground": "#FFB703",
    "gitDecoration.deletedResourceForeground": "#FF3E8A",
    "gitDecoration.untrackedResourceForeground": "#70FF00",
    "gitDecoration.ignoredResourceForeground": "#5B5470",
    "gitDecoration.conflictingResourceForeground": "#FF6B35",
    "diffEditor.insertedTextBackground": "#70FF001F",
    "diffEditor.removedTextBackground": "#FF3E8A1F",

    "breadcrumb.foreground": "#8F89A4",
    "breadcrumb.focusForeground": "#F8F9FC",
    "breadcrumb.activeSelectionForeground": "#FFB703",
    "breadcrumbCurrentItem.foreground": "#FFB703",

    "scrollbarSlider.background": "#40355444",
    "scrollbarSlider.hoverBackground": "#40355477",
    "scrollbarSlider.activeBackground": "#FFB70366",

    "notificationCenterHeader.background": "#111018",
    "notifications.background": "#171620",
    "notifications.border": "#2C293D",
    "notificationLink.foreground": "#00F0FF"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#746D87", "fontStyle": "italic" }
    },
    {
      "name": "Keywords & Control",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage.type",
        "storage.modifier"
      ],
      "settings": { "foreground": "#FF3E8A", "fontStyle": "bold" }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method"
      ],
      "settings": { "foreground": "#FFB703", "fontStyle": "bold" }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": { "foreground": "#70FF00" }
    },
    {
      "name": "String Escapes & Interpolation",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression"
      ],
      "settings": { "foreground": "#B5179E" }
    },
    {
      "name": "Numbers & Booleans",
      "scope": [
        "constant.numeric",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": { "foreground": "#FF6B35", "fontStyle": "bold" }
    },
    {
      "name": "Types, Classes & Interfaces",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.struct",
        "entity.name.enum",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#00F0FF", "fontStyle": "bold" }
    },
    {
      "name": "Variables & Parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter"
      ],
      "settings": { "foreground": "#F8F9FC" }
    },
    {
      "name": "Properties & Object Keys",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#38BDF8" }
    },
    {
      "name": "Operators & Delimiters",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.parameters"
      ],
      "settings": { "foreground": "#B5179E" }
    },
    {
      "name": "Brackets & Curly braces",
      "scope": [
        "punctuation.brackets",
        "punctuation.definition.bracket",
        "meta.brace"
      ],
      "settings": { "foreground": "#C4BFD4" }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#FF3E8A", "fontStyle": "bold" }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#FFB703" }
    },
    {
      "name": "JSON Keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#00F0FF", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Headings",
      "scope": ["markup.heading", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#FFB703", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#FF3E8A", "fontStyle": "bold" }
    },
    {
      "name": "Markdown Italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#FF6B35", "fontStyle": "italic" }
    },
    {
      "name": "Markdown Code",
      "scope": ["markup.inline.raw", "markup.raw.block"],
      "settings": { "foreground": "#70FF00" }
    },
    {
      "name": "Markdown Links",
      "scope": ["string.other.link.title.markdown", "markup.underline.link"],
      "settings": { "foreground": "#00F0FF" }
    },
    {
      "name": "CSS Classes and IDs",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": { "foreground": "#FFB703" }
    },
    {
      "name": "CSS Property Names",
      "scope": ["support.type.property-name.css"],
      "settings": { "foreground": "#00F0FF" }
    }
  ]
}
